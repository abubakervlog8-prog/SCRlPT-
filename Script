-- Action Button Builder Utility
local function createButton(text, color, xOffset, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 22, 0, 22)
    btn.Position = UDim2.new(1, xOffset, 0, 7)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = color
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    btn.Parent = mainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- Completely closes out the interface and stops active processing streams
local connection
local function selfDestruct()
    if connection then connection:Disconnect() end
    if rgbConnection and typeof(rgbConnection) == "RBXScriptConnection" then rgbConnection:Disconnect() end
    pcall(function()
        local base = workspace:FindFirstChild("Base")
        if base then
            for _, c in ipairs(base:GetDescendants()) do
                if c.Name == "BypassTracker" then c:Destroy() end
            end
        end
    end)
    screenGui:Destroy()
end

-- Toggle Visibility Frame Action
local frameVisible = true
local function toggleUI()
    frameVisible = not frameVisible
    mainFrame.BackgroundTransparency = frameVisible and 0 or 1
    uiStroke.Enabled = frameVisible
    for _, child in ipairs(mainFrame:GetChildren()) do
        if child:IsA("TextLabel") or (child:IsA("TextButton") and child.Text ~= "👁️") then
            child.Visible = frameVisible
        end
    end
end

