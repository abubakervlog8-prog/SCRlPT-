-- Algorithms System
local function parseSequencePath(sequenceArray)
    local position = 2 
    for _, moveName in ipairs(sequenceArray) do
        if moveName == "Shuffle1" or moveName == "Shuffle2" then
            if position == 2 then position = 3 elseif position == 3 then position = 2 end
        elseif moveName == "Shuffle3" or moveName == "Shuffle4" then
            if position == 1 then position = 2 elseif position == 2 then position = 1 end
        elseif moveName == "Shuffle5" or moveName == "Shuffle6" then
            if position == 1 then position = 3 elseif position == 3 then position = 1 end
        end
    end
    return position
end

local function flushTrackers()
    pcall(function()
        local base = workspace:FindFirstChild("Base")
        if base then
            for _, child in ipairs(base:GetDescendants()) do
                if child.Name == "BypassTracker" then child:Destroy() end
            end
        end
    end)
end

