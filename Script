local rgbConnection
rgbConnection = RunService and RunService.RenderStepped:Connect(function()
    if uiStroke and uiStroke.Parent then
        local hue = (tick() % 4) / 4
        uiStroke.Color = Color3.fromHSV(hue, 0.85, 1)
    else
        if rgbConnection then rgbConnection:Disconnect() end
    end
end) or coroutine.wrap(function()
    while mainFrame and uiStroke do
        for i = 0, 1, 0.005 do
            if not uiStroke then break end
            uiStroke.Color = Color3.fromHSV(i, 0.85, 1)
            task.wait(0.02)
        end
    end
end)()

